# 部署所需环境变量清单（**仅键名与非敏感默认，不含任何真实密钥**）
#
# 用法：按需复制为对应文件并填值，权限设为 600：
#   /opt/tes-edu-gateway/.env          <- 网关栈（compose 变量插值）
#   /opt/tes-edu-gateway/agent-backend.env
#   /opt/tes-edu-gateway/web-backend.env

# ============ 网关栈（137-gateway-stack.yml）============
# 未设置会在 compose up 时直接报错（${VAR:?} 强制）
REDIS_PASSWORD=
JWT_PUBLIC_KEY=
# 镜像标签：compose 以 image: .../${IMAGE_TAG:-latest} 引用 ACR 镜像。
# 默认 latest；要锁定版本可设为 CI 打出的 sha-<commit> 标签。
IMAGE_TAG=latest

# ============ agent-backend ============
# 大模型（DeepSeek / 通义 / Qwen，OpenAI 兼容 /v1）
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=qwen3.8-max
# 向量化（留空则走本地回退；可填 qwen3.7-text-embedding / text-embedding-v4，均 1024 维）
EMBED_BASE_URL=
EMBED_API_KEY=
EMBED_MODEL=
EMBED_DIM=1024
EMBED_BATCH=10
# 视觉模型（拍照识题，可选）
VLM_BASE_URL=
VLM_MODEL=
# 106 的 pgvector；密码含 @/# 需编码为 %40/%23；仅 137 可连
DB_DSN=
# 学情事件上报（留空则不上报，不影响解题）
KAFKA_BOOTSTRAP=kafka:9092
KAFKA_TOPIC_EVENT=student_event
TOP_K=4
SEED_PATH=data/seed_questions.json

# ============ web-backend ============
# 注意是 SQLAlchemy 形式（+asyncpg），与 agent-backend 的 asyncpg DSN 不同
DATABASE_URL=
EMBED_MODEL=
EMBED_API_BASE=
EMBED_API_KEY=
# Kafka 异步入库 + 学情消费
KAFKA_BOOTSTRAP=kafka:9092
KAFKA_TOPIC_INGEST=course_kb_ingest
KAFKA_TOPIC_EVENT=student_event
KAFKA_GROUP=course-kb-ingest
KAFKA_GROUP_EVENT=student-event-consumer
