# 部署所需环境变量清单（**仅键名与非敏感默认，不含任何真实密钥**）
#
# 用法：按需复制为对应文件并填值，权限设为 600：
#   /opt/tes-edu-gateway/.env          <- 网关栈（compose 变量插值）
#   /opt/tes-edu-gateway/agent-backend.env
#   /opt/tes-edu-gateway/web-backend.env

# ============ 网关栈（137-gateway-stack.yml）============
# 未设置会在 compose up 时直接报错（${VAR:?} 强制）
REDIS_PASSWORD=
JWT_PUBLIC_KEY=
# web-backend 的 /login 签发 RS256 令牌用（T-B5）。多行 PEM 不能进本文件，
# 由 deploy/publish_backend.sh 从 137 本地 secrets/jwt_private.pem 读入后
# 经 compose 变量 substitution 注入；手动 up 时同理 export。
JWT_PRIVATE_KEY=
# 镜像标签：compose 以 image: .../${IMAGE_TAG:-latest} 引用 ACR 镜像。
# 默认 latest；要锁定版本可设为 CI 打出的 sha-<commit> 标签。
IMAGE_TAG=latest

# ============ agent-backend ============
# 大模型（DeepSeek / 通义 / Qwen，OpenAI 兼容 /v1）
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=qwen3.8-max
# 向量化（留空则走本地回退；可填 qwen3.7-text-embedding / text-embedding-v4，均 1024 维）
EMBED_BASE_URL=
EMBED_API_KEY=
EMBED_MODEL=
EMBED_DIM=1024
EMBED_BATCH=10
# 视觉模型（拍照识题，可选）
VLM_BASE_URL=
VLM_MODEL=
# 106 的 pgvector；密码含 @/# 需编码为 %40/%23；仅 137 可连
DB_DSN=
# 学情事件上报（留空则不上报，不影响解题）
KAFKA_BOOTSTRAP=kafka:9092
KAFKA_TOPIC_EVENT=student_event
TOP_K=4
SEED_PATH=data/seed_questions.json

# ============ web-backend ============
# 注意是 SQLAlchemy 形式（+asyncpg），与 agent-backend 的 asyncpg DSN 不同
DATABASE_URL=
EMBED_MODEL=
EMBED_API_BASE=
EMBED_API_KEY=
# T-AM6：MCP 厂商/实例凭证加密密钥（32 字节，hex 或 base64）。
# 生成：python -c "import os;print(os.urandom(32).hex())"
# 留空则后端从 JWT_PRIVATE_KEY 派生并告警（仅限开发联调；生产必须显式配置，
# 轮换 JWT 私钥会使已存厂商凭证不可解密）。
VENDOR_CREDENTIAL_KEY=
# Kafka 异步入库 + 学情消费
KAFKA_BOOTSTRAP=kafka:9092
KAFKA_TOPIC_INGEST=course_kb_ingest
KAFKA_TOPIC_EVENT=student_event
KAFKA_GROUP=course-kb-ingest
KAFKA_GROUP_EVENT=student-event-consumer
# ============ web-backend —— M5-7 自主发现增强 ============
# 搜索引擎 API（M5-7-7）：接了才真正按关键词搜资源；不接则仅走可信域名种子兜底。
# 推荐 Serper（google.serper.dev，新账号送 2500 次），备选 Brave（自有索引防出网被墙）。
SEARCH_API_ENABLED=false
SEARCH_API_PROVIDER=serper
SEARCH_API_KEY=
SEARCH_API_URL=
SEARCH_API_MAX_RESULTS=10
# 发现策略增强（M5-7-8）
DISCOVERY_CRAWL_DEPTH=1            # BFS 递归同域探索深度（0=只看首页，1=首页+直链，2+=更深层）
DISCOVERY_CRAWL_MAX_PAGES=40       # 单次发现探索总页面预算（防失控 / 控出网成本）
DISCOVERY_HEADLESS_ENABLED=false    # 是否启用 headless 渲染抓 JS 站点；137 发版脚本会注入 true（此文件仅作示例）
DISCOVERY_RENDER_URL=              # 渲染服务端点；留空但启用时用同网络 http://headless-render:8000/render
DISCOVERY_HEADLESS_TIMEOUT=20.0     # 单个页面渲染超时（秒）

# ============ web-backend —— 真数字人（腾讯云智能数智人 IVH，SaaS 出卡）============
# 默认 DIGITAL_HUMAN_IMPL=lite（ffmpeg 字幕卡片，零 GPU）；改成 ivh 才走 SaaS 肖像口播。
# IVH 未配置 / 失败 / 超时会自动回退 Lite，业务不中断。
DIGITAL_HUMAN_IMPL=lite
IVH_BASE_URL=https://gw.tvs.qq.com
# **密钥只填在 137 的 web-backend.env（权限 600），本文件保持留空，绝不进 git / 镜像**
IVH_APPKEY=
IVH_ACCESSTOKEN=
# 形象照片公网 URL（COS 公有读或预签名）；137 的 MinIO 仅内网可达，不能填它的地址
IVH_REF_PHOTO_URL=
# Text=平台内置 TTS（默认，只传文本）；OriginalVoice=复用百炼 TTS 音频（需公网音频 URL）
IVH_DRIVER_TYPE=Text
IVH_AUDIO_PUBLIC_BASE=
IVH_TIMBRE_KEY=female_1
IVH_SPEED=1.0
IVH_VOLUME=0
# 出片很慢（720P 每秒视频约需 20 秒渲染），以下为提交/轮询/下载超时（秒）
IVH_MAX_SSML_CHARS=280
IVH_REQUEST_TIMEOUT=30.0
IVH_POLL_INTERVAL=10.0
IVH_POLL_TIMEOUT=1800.0
IVH_DOWNLOAD_TIMEOUT=120.0
# 成品只保留 7 天，出片后立即拉回归档；统一转 H.264/yuv420p 保证学生端可播
IVH_NORMALIZE_VIDEO=true

# 注意：平台「调用信息」页给出的 sign 是静态签名，aPaaS 接口签名必须每次动态计算，
# 请勿配置；virtualmanProjectId 属于交互数智人（建流），播报视频制作不需要。
