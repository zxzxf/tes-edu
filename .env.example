# 137 服务器部署用 .env 模板（权限 600，仅 root 可读；本文件为模板，请勿提交真实密钥）
# 用法：复制为 .env 后填入真实值，放置于 docker-compose.yml 同级目录。
#
# 注意：DATABASE_URL 含有特殊字符（如 #）时，整串必须用双引号包裹，否则 # 之后会被当作注释。

# ---- PostgreSQL + pgvector 数据层（位于 106 服务器 106.12.25.5，pg_hba 已白名单本机 137）----
# 口令需与 106 /opt/deploy/.env 中的 POSTGRES_PASSWORD 保持一致
DATABASE_URL="postgresql+asyncpg://tes:<POSTGRES_PASSWORD>@106.12.25.5:5432/tes_edu"

# ---- RS256 网关鉴权（与 137 网关共用同一密钥对）----
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----
...
-----END PUBLIC KEY-----"
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
...
-----END PRIVATE KEY-----"
