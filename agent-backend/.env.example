# ===== 大模型（DeepSeek / 通义 / Qwen，均为 OpenAI 兼容 /v1 接口）=====
LLM_BASE_URL=https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
# 该端点可选：qwen3.8-max / qwen3.7-max / qwen3.8-flash / deepseek-v4-pro / glm-5.3 等
LLM_MODEL=qwen3.8-max

# ===== 向量化（可选，默认关闭）=====
# 规则：EMBED_MODEL 留空 = 走本地确定性向量回退（链路可跑通，但语义质量有限，top1 相关度仅 ~0.5）；
#       显式填 EMBED_MODEL 才走真实 embedding（下方 URL/KEY 留空则复用 LLM 的）。
# 已验证可用的千问向量模型（均返回 1024 维，与 sql/embeddings.sql 的 VECTOR(1024) 一致）：
#   qwen3.7-text-embedding（最新，推荐）/ text-embedding-v4 / qwen3.7-text-embedding-flash
# 注意：并非所有 MaaS 端点都挂载了 embedding 模型，调不通请换端点或自建 Qwen3-Embedding。
EMBED_BASE_URL=
EMBED_API_KEY=
EMBED_MODEL=qwen3.7-text-embedding
EMBED_DIM=1024
# 单次请求的文本数上限：text-embedding-v4 为 10，qwen3.7-text-embedding 为 20；超出自动分批
EMBED_BATCH=10

# ===== 视觉模型（拍照识题，可选；留空则 OCR 降级，不阻塞主链路）=====
VLM_BASE_URL=
VLM_MODEL=

# ===== 数据层（106 的 pgvector/pg16；留空则走内存向量库）=====
DB_DSN=

# ===== 检索 =====
TOP_K=4
SEED_PATH=data/seed_questions.json
