# ===== 大模型（DeepSeek / 通义 / Qwen，均为 OpenAI 兼容 /v1 接口）=====
LLM_BASE_URL=https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
# 该端点可选：qwen3.8-max / qwen3.7-max / qwen3.8-flash / deepseek-v4-pro / glm-5.3 等
LLM_MODEL=qwen3.8-max

# ===== 向量化（可选，默认关闭）=====
# 实测：本 MaaS 端点不提供 embedding 模型（text-embedding-v3/v4 均 Model not exist）。
# 规则：EMBED_MODEL 留空 = 走本地确定性向量回退（链路可跑通，语义质量有限）；
#       只有显式填了 EMBED_MODEL 才走真实 embedding（此时下方 URL/KEY 留空则复用 LLM 的）。
EMBED_BASE_URL=
EMBED_API_KEY=
EMBED_MODEL=
EMBED_DIM=1024

# ===== 视觉模型（拍照识题，可选；留空则 OCR 降级，不阻塞主链路）=====
VLM_BASE_URL=
VLM_MODEL=

# ===== 数据层（106 的 pgvector/pg16；留空则走内存向量库）=====
DB_DSN=

# ===== 检索 =====
TOP_K=4
SEED_PATH=data/seed_questions.json
