# ===== 大模型（DeepSeek / 通义 / Qwen，均为 OpenAI 兼容 /v1 接口）=====
LLM_BASE_URL=https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
# 该端点可选：qwen3.8-max / qwen3.7-max / qwen3.8-flash / deepseek-v4-pro / glm-5.3 等
# 实测口径（ws 端点，2026-10-24）：qwen3.8-flash 可用（滚动配额，打满后一段时间恢复）、
# deepseek-v4-pro 可用；qwen3.8-max / deepseek-v4.1-flash 持续 403 Free quota exhausted。
# 生产默认 flash——曾误配 qwen3.8-max 导致 /solve 全量 500（403 透传），勿再改回。
LLM_MODEL=qwen3.8-flash

# ---- T-D2 模型路由分级（可选；留空即回落单一 LLM_MODEL，不会因缺配启动失败）----
#   LLM_MODEL_SIMPLE：简单题/直给档（mode=quick/similar、单选多选、引导档）
#   LLM_MODEL_HARD  ：难题（压轴解答、mode=explain 且步骤 ≥3）
# 二者必须配成**不同**模型才启用分级；任一留空或相同 = 关闭分级（行为同接入前）。
# 端点实测：flash 并发最快但滚动配额；deepseek 长 prompt 会挂起，勿设为 HARD 默认值。
LLM_MODEL_SIMPLE=
LLM_MODEL_HARD=

# ===== 向量化（可选，默认关闭）=====
# 规则：EMBED_MODEL 留空 = 走本地确定性向量回退（链路可跑通，但语义质量有限，top1 相关度仅 ~0.5）；
#       显式填 EMBED_MODEL 才走真实 embedding（下方 URL/KEY 留空则复用 LLM 的）。
# 已验证可用的千问向量模型（均返回 1024 维，与 sql/embeddings.sql 的 VECTOR(1024) 一致）：
#   qwen3.7-text-embedding（最新，推荐）/ text-embedding-v4 / qwen3.7-text-embedding-flash
# 注意：并非所有 MaaS 端点都挂载了 embedding 模型，调不通请换端点或自建 Qwen3-Embedding。
EMBED_BASE_URL=
EMBED_API_KEY=
EMBED_MODEL=qwen3.7-text-embedding
EMBED_DIM=1024
# 单次请求的文本数上限：text-embedding-v4 为 10，qwen3.7-text-embedding 为 20；超出自动分批
EMBED_BATCH=10

# ===== 视觉模型（拍照识题，可选；留空则 OCR 降级，不阻塞主链路）=====
VLM_BASE_URL=
VLM_MODEL=

# ===== 数据层（106 的 pgvector/pg16；留空则走内存向量库）=====
DB_DSN=

# ===== 学情事件上报（Kafka，可选）=====
# 留空则不上报（不影响解题功能）；137 的 kafka 已接入 edu-net，容器内用 kafka:9092
KAFKA_BOOTSTRAP=
KAFKA_TOPIC_EVENT=student_event

# ===== 检索 =====
TOP_K=4
SEED_PATH=data/seed_questions.json

# ===== T-D1 请求级缓存 =====
# 缓存总开关：出事故（缓存串味 / Redis 抖动）时可一键关掉，关掉后每次都回源 LLM
CACHE_ENABLED=true
# Redis（137 edu-redis，agent 容器同网）；留空则按 host/port/db/password 拼
REDIS_URL=
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
