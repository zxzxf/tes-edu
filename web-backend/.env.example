# PostgreSQL + pgvector（106 的 tes_edu 库）
# 注意：密码含 @ 与 #，必须百分号编码（@ -> %40，# -> %23），否则 URL 解析失败
# 另：106 的 pg_hba 只放行 124.221.253.137（即 137），本服务部署在 137 上才连得通
DATABASE_URL=postgresql+asyncpg://tes:Tes%40Pg%23106@106.12.25.5:5432/tes_edu

# Embedding（P2 语义检索，暂未启用；启用后 course_kb.embedding 才有值）
EMBED_MODEL=
EMBED_API_BASE=
EMBED_API_KEY=

# Kafka 异步入库管道（course_kb_ingest）
# 注意：137 的 kafka 在 opt_default 网络，broker 宣告地址是容器主机名，
# 本服务必须同时接入 opt_default 才解析得到；容器内用 kafka:9092 引导
# 留空则降级为同步直写（功能仍可用）
KAFKA_BOOTSTRAP=kafka:9092
KAFKA_TOPIC_INGEST=course_kb_ingest
KAFKA_GROUP=course-kb-ingest
